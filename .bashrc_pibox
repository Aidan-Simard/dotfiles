# Pi sandbox helpers (installed with apply.sh --all)
#
# The sandbox is a rootless Podman container with only the project directory
# and a dedicated sandbox home mounted from the host. Pi's auth is copied into
# the sandbox home once; the host ~/.pi/agent is never mounted.

PIBOX_IMAGE="${PIBOX_IMAGE:-localhost/pi-box:1.6.0}"
PIBOX_STATE="${PIBOX_STATE:-$HOME/.local/share/pi-box}"
PIBOX_HOME="$PIBOX_STATE/home"
PIBOX_CONTAINERFILE="${PIBOX_CONTAINERFILE:-$HOME/.config/pi-box/Containerfile}"

_pibox_prepare() {
    command -v podman >/dev/null 2>&1 || {
        echo "pibox: podman is not installed" >&2
        return 1
    }

    [ -f "$PIBOX_CONTAINERFILE" ] || {
        if ! podman image exists "$PIBOX_IMAGE" >/dev/null 2>&1; then
            echo "pibox: missing $PIBOX_CONTAINERFILE; run apply.sh --all" >&2
            return 1
        fi
    }

    _PIBOX_PROJECT=$(pwd -P) || return 1

    if [ "$_PIBOX_PROJECT" = "$HOME" ] || [ "$_PIBOX_PROJECT" = "/" ]; then
        echo "pibox: refusing to sandbox from $_PIBOX_PROJECT" >&2
        return 1
    fi

    mkdir -p "$PIBOX_HOME/.pi/agent"
    chmod 700 "$PIBOX_STATE" "$PIBOX_HOME" 2>/dev/null || true

    # Seed the sandbox with a copy of the host credentials once. The host
    # ~/.pi/agent directory itself is never exposed to the container.
    if [ ! -f "$PIBOX_HOME/.pi/agent/auth.json" ] && [ -f "$HOME/.pi/agent/auth.json" ]; then
        cp "$HOME/.pi/agent/auth.json" "$PIBOX_HOME/.pi/agent/auth.json"
        chmod 600 "$PIBOX_HOME/.pi/agent/auth.json"
    fi
    if [ ! -f "$PIBOX_HOME/.pi/agent/settings.json" ] && [ -f "$HOME/.pi/agent/settings.json" ]; then
        cp "$HOME/.pi/agent/settings.json" "$PIBOX_HOME/.pi/agent/settings.json"
    fi

    if ! podman image exists "$PIBOX_IMAGE" >/dev/null 2>&1; then
        echo "pibox: building $PIBOX_IMAGE (first run only)..." >&2
        podman build -t "$PIBOX_IMAGE" -f "$PIBOX_CONTAINERFILE" \
            "$(dirname "$PIBOX_CONTAINERFILE")" || return 1
    fi
}

_pibox_run() {
    local project="$1"
    local mode="$2"
    shift 2

    local run_args=(
        --rm
        -it
        --userns=keep-id
        --user "$(id -u):$(id -g)"
        --security-opt=no-new-privileges
        --cap-drop=ALL
        --init
        --hostname pi-box
        --label "pibox.project=$project"
        -e HOME=/home/pi
        -e PI_CODING_AGENT_DIR=/home/pi/.pi/agent
        -v "$PIBOX_HOME:/home/pi:rw"
        -v "$project:$project:rw"
        -w "$project"
    )

    case "$mode" in
        pi)
            podman run "${run_args[@]}" "$PIBOX_IMAGE" "$@"
            ;;
        shell)
            podman run "${run_args[@]}" --entrypoint bash "$PIBOX_IMAGE" -l
            ;;
        *)
            echo "pibox: unknown mode: $mode" >&2
            return 1
            ;;
    esac
}

# Run Pi inside the sandbox for the current project directory.
pibox() {
    _pibox_prepare || return 1
    _pibox_run "$_PIBOX_PROJECT" pi "$@"
}

# Open a shell in a fresh container with the same project and sandbox home.
pibox-shell() {
    _pibox_prepare || return 1
    _pibox_run "$_PIBOX_PROJECT" shell
}

# Rebuild the sandbox image after changing the Containerfile.
pibox-build() {
    command -v podman >/dev/null 2>&1 || {
        echo "pibox-build: podman is not installed" >&2
        return 1
    }
    [ -f "$PIBOX_CONTAINERFILE" ] || {
        echo "pibox-build: missing $PIBOX_CONTAINERFILE; run apply.sh --all" >&2
        return 1
    }
    podman build -t "$PIBOX_IMAGE" -f "$PIBOX_CONTAINERFILE" \
        "$(dirname "$PIBOX_CONTAINERFILE")"
}

# Remove the persistent sandbox home (Pi credentials, settings, sessions).
pibox-reset() {
    rm -rf "$PIBOX_STATE"
    echo "removed $PIBOX_STATE"
}

# Like d(), but window 1 starts the sandbox and runs Pi inside it.
dpi() {
    local wd session
    wd=$(basename "$PWD")
    wd=$(printf '%s' "$wd" | tr -c 'A-Za-z0-9_-' '-')
    session="${wd}-pi"

    if tmux has-session -t "$session" 2>/dev/null; then
        tmux attach-session -t "$session"
        return
    fi

    tmux new-session -d -s "$session" -n nvim
    tmux send-keys -t "$session:nvim" 'nvim .' Enter

    tmux new-window -t "$session" -n pi
    tmux send-keys -t "$session:pi" 'pibox' Enter

    tmux new-window -t "$session" -n shell

    tmux select-window -t "$session:nvim"
    tmux attach-session -d -t "$session"
}
